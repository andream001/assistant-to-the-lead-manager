# ==============================================================================
# ASSISTANT TO THE LEAD MANAGER - EVOLUTION API (5 CHIPS SIMULTANEOS)
# Copie este arquivo para .env e preencha suas configuracoes locais
# ==============================================================================

# Servidor Evolution API (Docker porta 8081)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=sua_chave_global_evolution_aqui

# Configuracao do Servidor Web & Webhook Receiver
PORT=5000
DEBUG=False
WEBHOOK_VERIFY_TOKEN=seu_token_secreto_para_verificacao
WEBHOOK_INTERNAL_URL=http://host.docker.internal:5000/webhook

# WhatsApp do Consultor Responsavel (Recebe alertas de leads interessados com link wa.me)
CONSULTANT_PHONE_NUMBER=5511999999999

# Configuracoes de Campanha, Warm-Up e Jitter Anti-Ban
DRY_RUN=True
DAILY_MESSAGE_LIMIT=60
MIN_DELAY=6.0
MAX_DELAY=15.0
TYPING_MS=1200
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=18
BUSINESS_DAYS_ONLY=True

# Caminhos de Dados (Se data/leads.local.csv existir, sera usado automaticamente sem ir para o Git)
LEADS_FILE=data/leads.csv
ACCOUNTS_FILE=data/whatsapp_accounts.json
EVENTS_LOG=data/events.log
